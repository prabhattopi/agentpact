# ==========================================
# AgentPact Environment Configuration
# ==========================================

# 1. Neon Serverless Postgres DB URL
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://neondb_owner:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Google Gemini API Key (Gemini 2.5 Flash / Flash Lite / Pro)
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# 3. PayPal Developer Sandbox Credentials
# Get sandbox keys from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID="your-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-sandbox-client-secret"
PAYPAL_MODE="sandbox" # sandbox or live
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

